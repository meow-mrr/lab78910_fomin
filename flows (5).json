    {
        "id": "ed5b43593b36445e",
        "type": "function",
        "z": "4e06457bb2ac519c",
        "name": "function 1",
        "func": "let op = msg.req.query.op;\nlet a = Number(msg.req.query.a);\nlet b = Number(msg.req.query.b);\nlet isRad = msg.req.query.isRad === \"true\";\n\nfunction toRad(x) {\n    return isRad ? x : x * Math.PI / 180;\n}\n\nswitch (op) {\n    case \"sin\": msg.payload = Math.sin(toRad(a)); break;\n    case \"cos\": msg.payload = Math.cos(toRad(a)); break;\n    case \"tan\": msg.payload = Math.tan(toRad(a)); break;\n\n    case \"ctg\":\n        let t = Math.tan(toRad(a));\n        msg.payload = (t === 0) ? \"ctg не определён\" : 1 / t;\n        break;\n\n    case \"pow\": msg.payload = Math.pow(a, b); break;\n    case \"root\": msg.payload = Math.sqrt(a); break;\n    case \"exp\": msg.payload = Math.exp(a); break;\n    case \"pi\": msg.payload = Math.PI; break;\n\n    default:\n        msg.payload = \"Неизвестная операция\";\n}\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
